{
  "name": "dcp-infocenter",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local server/gateway.mjs",
    "devices": "node server/gateway.mjs devices",
    "configure": "node scripts/configure-local.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "electron": "electron electron/main.cjs",
    "package:electron": "electron-builder --win portable"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "top.dcpstudios.infocenter",
    "productName": "DCP InfoCenter",
    "directories": {"output": "release/electron"},
    "files": ["electron/**/*", "package.json"],
    "win": {"target": "portable"}
  }
}
