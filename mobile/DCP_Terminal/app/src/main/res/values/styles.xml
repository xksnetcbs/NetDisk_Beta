<resources>
 <string name="widget_description">轮播待办、前往地点、紧急消息与状态切换总结；点击打开应用</string>
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#007AFF</item><item name="android:windowLightStatusBar">true</item><item name="android:windowActionModeOverlay">true</item>
  <item name="android:alertDialogTheme">@style/CompactDialogLight</item>
  <item name="android:textSize">13sp</item>
 </style>
 <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">#64A8FF</item><item name="android:alertDialogTheme">@style/CompactDialogDark</item><item name="android:textSize">13sp</item></style>
 <style name="CompactDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert"><item name="android:colorAccent">#25796C</item><item name="android:textSize">13sp</item><item name="android:windowAnimationStyle">@style/PanelAnimation</item></style>
 <style name="CompactDialogDark" parent="android:style/Theme.Material.Dialog.Alert"><item name="android:colorAccent">#83CBB6</item><item name="android:textSize">13sp</item><item name="android:windowAnimationStyle">@style/PanelAnimation</item></style>
 <style name="PanelAnimation"><item name="android:windowEnterAnimation">@anim/panel_enter</item><item name="android:windowExitAnimation">@anim/panel_exit</item></style>
</resources>
