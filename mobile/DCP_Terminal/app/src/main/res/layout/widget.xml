<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/todo_root" android:padding="14dp" android:orientation="vertical" android:background="@drawable/attention_background" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="44dp">
  <TextView android:id="@+id/title" android:text="DCP 待办" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center_vertical" android:layout_width="78dp" android:layout_height="match_parent"/>
  <TextView android:id="@+id/widget_status" android:text="正在准备" android:textSize="11sp" android:textColor="#ABC3D3" android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
  <TextView android:id="@+id/widget_refresh" android:text="↻" android:contentDescription="刷新桌面卡片" android:gravity="center" android:textSize="23sp" android:textColor="#64A8FF" android:layout_width="44dp" android:layout_height="44dp"/>
 </LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/widget_list" android:divider="#2D4250" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <TextView android:id="@+id/widget_empty" android:gravity="center" android:textColor="#ABC3D3" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="match_parent"/>
 </FrameLayout>
</LinearLayout>
