<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card_root" android:orientation="vertical" android:padding="14dp" android:background="@drawable/attention_background" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="36dp">
  <TextView android:id="@+id/card_label" android:textSize="13sp" android:textColor="#65717B" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/card_action" android:text="打开  ↗" android:gravity="center" android:textSize="13sp" android:textColor="#25796C" android:layout_width="64dp" android:layout_height="36dp"/>
 </LinearLayout>
 <TextView android:id="@+id/card_title" android:textSize="20sp" android:textStyle="bold" android:textColor="#172C31" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
 <TextView android:id="@+id/card_body" android:textSize="12sp" android:textColor="#4B6165" android:maxLines="2" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/card_footer" android:textSize="11sp" android:textColor="#65717B" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
